# Copy to .env for local dev. Never commit a real .env.
# Production values come from a secrets manager — see SYSTEM_DESIGN.md,
# "Key management". This file exists to name what's needed, not to hold it.

ENV=local

# API — JWT_SECRET must be a real 256-bit high-entropy value in every non-local env
JWT_SECRET=change-me-in-every-env-except-local
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_RATE_LIMIT=10/minute
AUDIT_LOG_AI_PARSER_RATE_LIMIT=20/minute

# CORS — Comma-separated list of allowed frontend origins (never use wildcard *)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/legadoc

# Object storage (MinIO / S3-compatible)
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=legadoc-documents

# Queue
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Hyperledger Fabric (chain_worker only, set directly in docker-compose.yml's
# chain_worker service, not here — FABRIC_SAMPLES_DIR, FABRIC_ORDERER_ADDRESS,
# FABRIC_PEER0_ORG1_ADDRESS, FABRIC_PEER0_ORG2_ADDRESS. All default sensibly
# in workers/chain_worker/fabric_client.py; override only if your Fabric
# network setup differs from fabric-network/README.md's default layout.
