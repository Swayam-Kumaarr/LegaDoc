# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# LocalObjectStorage's dev-mode file store — never committed, see app/storage.py
api/data/

# Fabric local dev/test crypto material and generated connection profiles —
# never real production keys, but never committed either. See fabric-network/README.md.
fabric-network/connection-profile.json
fabric-network/organizations/
fabric-network/*.pem
fabric-network/*.key

# Go build artifacts, if the chaincode is ever built locally — a single
# `*` (one path segment) here, not `**`, which would also match (and hide)
# the hashledger/ SOURCE directory itself since `**` matches zero segments too.
fabric-network/chaincode/*/hashledger
fabric-network/chaincode/*/*.exe

# Node / React
node_modules/
dist/
build/

# Env & secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Gradle / Android (in case a nested tool ever touches this repo)
.gradle/
*.gradle.lockfile

# Generated PDFs & local docs
*.pdf


# Go vendor directory — regenerable via 'go mod vendor', not our code
fabric-network/chaincode/*/vendor/
