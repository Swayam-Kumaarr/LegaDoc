# LegaDoc production-shaped settings for a single demo VM.
# On the VM, from the repo root:
#   cp deploy/env.production.example .env
# then replace every CHANGE_ME. Never commit the resulting .env.
# Generate secrets with:   openssl rand -hex 32

ENV=production

# Tokens: a leaked or default JWT_SECRET lets anyone mint an admin token.
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Public hostnames (DNS on Cloudflare). FILES_HOST serves document downloads.
APP_HOST=legadoc.example.in
FILES_HOST=files.legadoc.example.in
CORS_ORIGINS=https://legadoc.example.in

# Postgres. The password appears twice: once for the db container, once inside DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://postgres:CHANGE_ME@db:5432/legadoc

# MinIO. OBJECT_STORAGE_ACCESS_KEY / SECRET_KEY must equal MINIO_ROOT_USER / PASSWORD.
MINIO_ROOT_USER=legadoc
MINIO_ROOT_PASSWORD=CHANGE_ME
# Needed because ENV=production makes the API request server-side encryption.
# Format is name:base64-of-32-bytes. Generate with:
#   echo "legadoc-key:$(openssl rand -base64 32)"
MINIO_KMS_SECRET_KEY=legadoc-key:CHANGE_ME
OBJECT_STORAGE_BACKEND=minio
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=https://files.legadoc.example.in
OBJECT_STORAGE_ACCESS_KEY=legadoc
OBJECT_STORAGE_SECRET_KEY=CHANGE_ME
OBJECT_STORAGE_BUCKET=legadoc-documents

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Web container port on the VM's loopback (Cloudflare Tunnel connects to it over Docker's network).
WEB_PORT=8080

# Only used with --profile tunnel. Copy it from Cloudflare Zero Trust > Networks > Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=
